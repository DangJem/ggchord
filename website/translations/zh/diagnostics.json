      "translation": "## 根据现象选择核对项 {#checks}\n"
    },
    "6": {
      "source_sha256": "d76982f3f0a9845798edc72862d9c1068dbb22d147ba1ba71f334498b733fe66",
      "status": "reviewed",
      "translation": "| 问题 | 查看什么 |\n"
    },
    "7": {
      "source_sha256": "3491e014f5503eb5b2fca81db42f6f72765980ba5b5e48ef135b6cf69d7f92cc",
